// Template for Secrets.xcconfig (which is gitignored). To set up:
//   1. Copy this file to Secrets.xcconfig:  cp Secrets.example.xcconfig Secrets.xcconfig
//   2. Create a Trakt app at https://trakt.tv/oauth/applications
//      (Redirect URI: urn:ietf:wg:oauth:2.0:oob) and paste its values below.
//   3. Run `xcodegen generate` and build.
//
// Leaving these blank is fine — the app builds and runs, and the Trakt row
// simply doesn't appear in Settings until both values are present.
TRAKT_CLIENT_ID =
TRAKT_CLIENT_SECRET =

// TMDB v3 API key from https://www.themoviedb.org/settings/api (the short
// 32-char "API Key", sent as a query param — not the v4 Read Access Token).
// Leaving it blank is fine — metadata enrichment simply doesn't run.
TMDB_API_KEY =
